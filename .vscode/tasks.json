{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "تشغيل النظام بالكامل (Backend + Frontend)",
      "dependsOn": [
        "تشغيل الباك إند (Backend)",
        "تشغيل الفرونت إند (Frontend)"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "تشغيل الباك إند (Backend)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "تشغيل الفرونت إند (Frontend)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    }
  ]
}
